#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        sys_left {
            bindings = <&mo 3>;
            key-positions = <38 36>;
        };

        sys_right {
            bindings = <&mo 3>;
            key-positions = <39 41>;
        };
    };

    behaviors {
        keypad_dot: keypad_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYPAD_DOT";
            bindings = <&kp KP_DOT>, <&kp PERIOD>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        space_shift: space_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "SPACE_SHIFT";
            bindings = <&kp SPACE>, <&kp LEFT_SHIFT>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT|MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LALT|MOD_RALT|MOD_LCTL|MOD_RCTL)>;
        };

        swap: swapper {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <14>;
        };

        // Alt is only held while &swap is active: Shift+Tab then, Ctrl+Shift otherwise.
        // keep-mods is required so Alt stays held and the window switcher stays open.
        swap_back: swap_back {
            compatible = "zmk,behavior-mod-morph";
            label = "SWAP_BACK";
            bindings = <&kp LC(LEFT_SHIFT)>, <&kp LS(TAB)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        nav_ht: nav_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;       // tap then hold repeats the arrow
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E      &kp R           &kp T           &kp Y           &kp U           &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&kp LEFT_SHIFT     &kp A  &kp S  &kp D      &kp F           &kp G           &kp H           &kp J           &kp K      &kp L       &kp SEMICOLON  &kp SQT
&trans            &kp Z  &kp X  &kp C      &kp V           &kp B           &kp N           &kp M           &kp COMMA  &kp PERIOD  &kp SLASH      &trans
                          &kp LCTRL  &kp SPACE       &mo 1           &kp LEFT_SHIFT  &mo 2           &kp ENTER
                                     &kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp LEFT_SHIFT
            >;
        };

        numbers {
            bindings = <
&trans  &trans              &trans              &trans              &trans  &trans  &kp BACKSLASH  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans   &kp LC(LEFT_SHIFT)  &swap_back          &swap              &trans   &trans  &kp N0         &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans              &trans              &trans              &trans  &trans  &kp MINUS      &kp N1  &kp N2  &kp N3  &trans  &trans
                                                &kp LC(LEFT_SHIFT)  &trans  &trans  &trans         &trans  &trans
                                                                    &trans  &trans  &trans         &trans
            >;
        };

        navigation {
            bindings = <
&trans  &trans  &trans    &trans         &trans          &kp SQT    &kp PG_UP      &trans          &trans          &trans           &trans   &trans
&trans  &trans  &trans    &kp PG_UP      &kp MINUS         &kp TAB   &kp PAGE_DOWN  &kp BACKSPACE   &kp UP_ARROW    &kp DELETE       &trans   &trans
&trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp END         &kp SLASH  &kp HOME       &nav_ht HOME LEFT  &kp DOWN_ARROW  &nav_ht END RIGHT  &kp END  &trans
                          &trans         &kp LEFT_SHIFT  &trans     &trans         &trans          &trans
                                         &trans          &trans     &trans         &trans
            >;
        };

        system {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &sys_reset      &sys_reset      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &bootloader     &bootloader     &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans          &trans          &trans  &trans
                                &trans  &trans          &trans          &trans
            >;
        };
    };
};
